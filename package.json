{
  "name": "igniteui-i18n",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:core": "tsc --project projects/igniteui-i18n-core/tsconfig.build.json",
    "build:resources": "tsc --project projects/igniteui-i18n-resources/tsconfig.build.json",
    "clean:core": "rimraf ./dist/igniteui-i18n-core",
    "clean:resources": "rimraf ./dist/igniteui-i18n-resources",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "test": "vitest --config vitest.browser.config.ts",
    "test:inline": "vitest",
    "prepare": "husky",
    "check:bundle": "node check-bundle.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-istanbul": "^5.0.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,ts,mjs,json}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  }
}
